# ---- Required ----
# Get a free key (no credit card needed) at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# ---- GitHub source (used by ingest.py to pull repo code + READMEs) ----
GITHUB_USERNAME=AbhijithReddie
# Optional but recommended: a personal access token raises GitHub's API
# rate limit from 60/hour to 5000/hour. Create one at
# https://github.com/settings/tokens (no special scopes needed for public repos).
GITHUB_TOKEN=

# ---- CORS ----
# The exact origin(s) of your deployed portfolio site, comma-separated.
# Example: https://abhijithreddie.github.io,https://your-custom-domain.com
# Use * only for local testing.
FRONTEND_ORIGIN=*

# ---- Models (safe to leave as-is) ----
# gemini-embedding-001: free via Google AI Studio, replaces the deprecated text-embedding-004
EMBEDDING_MODEL=gemini-embedding-001
# gemini-3.6-flash: free-tier Flash model, good quality/speed for this use case.
# (Gemini's Pro models require billing — stick to Flash/Flash-Lite models to stay free.)
CHAT_MODEL=gemini-3.6-flash
